# ==============================================================================
# Bitcoin Transaction Monitoring & Analysis System - Local Environment Config (Template)
# Copy this file to .env.local for local customization
# ==============================================================================

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/bitcoin_monitoring
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Neo4j Graph Database Configuration (optional, falls back to NetworkX)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=bitcoin_secure_2025

# FastAPI Server Configuration
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000

# Streamlit Configuration
STREAMLIT_HOST=127.0.0.1
STREAMLIT_PORT=8501

# MaxMind GeoIP Offline MMDB Paths
GEOIP_COUNTRY_DB=data/geoip/GeoLite2-Country.mmdb
GEOIP_ASN_DB=data/geoip/GeoLite2-ASN.mmdb

# Offline Operation Flag (1 = strictly offline, no external network calls)
OFFLINE_MODE=1
